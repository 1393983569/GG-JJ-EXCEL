# 改这两处域名即可，其余不用动
admin.example.com {
	@pb path /api/* /_/*
	handle @pb {
		reverse_proxy pb:4399
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

m.example.com {
	# H5 的 TARO_APP_PB_URL 留空 = 走同源，所以这里必须把 /api、/_ 转发给 PocketBase
	@pb path /api/* /_/*
	handle @pb {
		reverse_proxy pb:4399
	}
	handle {
		root * /srv/h5
		try_files {path} /index.html
		file_server
	}
}
